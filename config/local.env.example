# Nome do AVD criado no Android Studio (exatamente como aparece em emulator -list-avds)
AVD_NAME=Pixel_2_XL

# Caminho do Android SDK (Windows padrão)
ANDROID_SDK_ROOT=C:\Users\SEU_USUARIO\AppData\Local\Android\Sdk

# Quantos emuladores (máquina fraca: 1-2, máquina boa: 3-5)
MAX_DEVICES=3

# Porta base do emulador
BASE_PORT=5554
